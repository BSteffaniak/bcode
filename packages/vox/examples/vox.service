[Unit]
Description=Vox local dictation service
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# Replace /absolute/path with the installed binary; keep configuration explicit.
ExecStart=/absolute/path/to/vox --config %h/.config/vox/config.toml serve
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=graphical-session.target
