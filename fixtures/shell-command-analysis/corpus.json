    },
    {
      "id": "git-no-pager-reviewed-alias",
      "classification": "canonicalization_defect",
      "source": "git --no-pager diff --stat",
      "policy": {"rules": [{"pattern": "git diff *", "action": "allow"}, {"pattern": "git *", "action": "deny"}], "default_action": "deny"},
      "expected": {"commands": ["git --no-pager diff --stat"], "aliases": ["git diff --stat"], "redirections": [], "completeness": "complete", "policy": "allow"},
      "notes": "The reviewed behavior-neutral alias competes by normal wildcard specificity while retaining the original candidate; a more specific restrictive original match would still win."
    },
    {
      "id": "environment-assignment-prefix",
      "classification": "canonicalization_defect",
      "source": "GIT_PAGER=cat git show --stat HEAD",
      "policy": {"rules": [{"pattern": "git show *", "action": "allow"}, {"pattern": "git *", "action": "deny"}], "default_action": "deny"},
      "expected": {"commands": ["GIT_PAGER=cat git show --stat HEAD"], "executables": ["git"], "assignments": ["GIT_PAGER=cat"], "redirections": [], "completeness": "complete", "policy": "ask"},
      "notes": "Alias safety for GIT_PAGER remains a review decision; parsing must still identify git rather than the assignment."
    },
