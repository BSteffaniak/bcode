{
  "schema_version": 1,
  "dialect": "posix",
  "cases": [
    {
      "id": "newline-denied-sibling",
      "classification": "parser_boundary_defect",
      "source": "printf '%s\\n' safe\nrm -f generated.txt",
      "policy": {"rules": [{"pattern": "printf *", "action": "allow"}, {"pattern": "rm *", "action": "deny"}], "default_action": "ask"},
      "expected": {"commands": ["printf '%s\\n' safe", "rm -f generated.txt"], "redirections": [], "completeness": "complete", "policy": "deny"}
    },
    {
      "id": "background-denied-sibling",
      "classification": "parser_boundary_defect",
      "source": "sleep 1 & rm -f generated.txt",
      "policy": {"rules": [{"pattern": "sleep *", "action": "allow"}, {"pattern": "rm *", "action": "deny"}], "default_action": "ask"},
      "expected": {"commands": ["sleep 1", "rm -f generated.txt"], "redirections": [], "completeness": "complete", "policy": "deny"}
    },
    {
      "id": "pipeline-denied-leaf",
      "classification": "parser_boundary_defect",
